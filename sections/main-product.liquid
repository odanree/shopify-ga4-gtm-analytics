{% comment %}
  main-product.liquid
  Product page section — extends Dawn's main-product section with:
    1. GTM dataLayer view_item push (server-rendered)
    2. Product JSON-LD structured data
    3. data-* attributes on product card for select_item tracking from collection grids
{% endcomment %}

{%- assign current_variant = product.selected_or_first_available_variant -%}

{%- comment -%} === ANALYTICS: view_item dataLayer push {%- endcomment -%}
{%- render 'datalayer-product', product: product, current_variant: current_variant -%}

{%- comment -%} === SEO: Product JSON-LD structured data {%- endcomment -%}
{%- render 'product-jsonld', product: product -%}

<section
  id="MainProduct-{{ section.id }}"
  class="page-width section-{{ section.id }}-padding"
  data-section="{{ section.id }}"
>
  <div class="product product--{{ section.settings.media_size }} grid grid--1-col{% if product.media.size > 0 %} grid--2-col-tablet{% endif %}">

    {%- comment -%} Media column {%- endcomment -%}
    <div class="grid__item product__media-wrapper">
      {%- if product.featured_media -%}
        <div class="product__media-list">
          {%- for media in product.media -%}
            <div class="product__media-item{% if media == product.featured_media %} product__media-item--active{% endif %}">
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  <img
                    srcset="{{ media | img_url: '360x' }} 360w, {{ media | img_url: '720x' }} 720w, {{ media | img_url: '1080x' }} 1080w"
                    sizes="(min-width: 750px) 50vw, 100vw"
                    src="{{ media | img_url: '720x' }}"
                    alt="{{ media.alt | escape }}"
                    width="{{ media.width }}"
                    height="{{ media.height }}"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  >
                {%- when 'video' -%}
                  {{ media | video_tag: autoplay: false, loop: false, controls: true }}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Info column {%- endcomment -%}
    <div class="grid__item product__info-wrapper">
      <div class="product__info-container">

        <h1 class="product__title">{{ product.title }}</h1>

        {%- if product.vendor != blank -%}
          <div class="product__vendor">{{ product.vendor }}</div>
        {%- endif -%}

        <div class="product__price">
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <s class="price--compare">{{ current_variant.compare_at_price | money }}</s>
          {%- endif -%}
          <span class="price">{{ current_variant.price | money }}</span>
        </div>

        <div class="product__description rte">
          {{ product.description }}
        </div>

        {%- form 'product', product, id: 'product-form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">

          {%- for option in product.options_with_values -%}
            <div class="product__variant-option">
              <label>{{ option.name }}</label>
              <select name="options[{{ option.name | escape }}]">
                {%- for value in option.values -%}
                  <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>
                    {{ value }}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- endfor -%}

          <button
            type="submit"
            name="add"
            class="product__submit button button--full-width button--primary"
            {% unless current_variant.available %}disabled{% endunless %}
          >
            {%- if current_variant.available -%}
              Add to cart
            {%- else -%}
              Sold out
            {%- endif -%}
          </button>
        {%- endform -%}

      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "media_size",
      "label": "Media width",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    }
  ],
  "presets": [
    {
      "name": "Product information"
    }
  ]
}
{% endschema %}
